# Copiar a .env y completar. NUNCA commitear el .env real.

# Base de datos (Docker Compose expone Postgres en 5435 para no chocar con un
# Postgres nativo en 5432; ajustar el puerto al que uses).
DATABASE_URL=postgresql://postgres:anticheat@localhost:5435/anticheat

PORT=4000
NODE_ENV=development

# Clave para los endpoints admin (header x-api-key). Mínimo 32 caracteres.
ADMIN_API_KEY=change-me-min-32-characters-long-000

# Atestación: stub (dev/test) | google (Play Integrity real)
ATTESTATION_PROVIDER=stub
ATTESTATION_STUB_VERDICT=MEETS_STRONG

# Solo para ATTESTATION_PROVIDER=google (GooglePlayIntegrityVerifier)
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_APPLICATION_CREDENTIALS=
PLAY_INTEGRITY_PACKAGE_NAME=

# Ciclo de vida de sesión (reaper + gap analysis)
SESSION_TIMEOUT_MULTIPLIER=3        # N×interval sin actividad → ABORTED
SESSION_MIN_COVERAGE_RATIO=0.5      # < este ratio de snapshots → INCOMPLETE
CLOCK_SKEW_TOLERANCE_SEC=120

# Límite de tamaño del body de snapshot (bytes)
SNAPSHOT_MAX_BODY_BYTES=65536

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
